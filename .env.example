# Copy to .env.local (git-ignored). All optional: unset values fall back to the
# production defaults in src/config/env.ts.

# Clerk dev instance key (pk_test_...) for local work; unset = production pk_live.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Tally form ID for the /careers Apply buttons. Unset = production form.
PUBLIC_TALLY_FORM_ID=
